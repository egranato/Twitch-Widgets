{
  "name": "twitch-widgets-desktop",
  "version": "0.4.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder --dir",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.twitchwidgets.desktop",
    "productName": "Twitch Widgets Desktop",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../NigredoServer",
        "to": "NigredoServer",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!output/**",
          "!obs/output/**",
          "!.env",
          "!user-creds.json"
        ]
      },
      {
        "from": "../NigredoServer/node_modules",
        "to": "NigredoServer/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "assets/TwitchCompanionIcon256.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
